+import argparse
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass, replace
+from itertools import chain
+import json
+import sys
+import time
+from typing import Final, Protocol, TypeAlias, Union, cast
+from urllib.parse import quote
+
+import controller as c
+import discover_anthropic_profiles as discovery
+
+Json: TypeAlias = Union[None, bool, int, float, str, list["Json"], dict[str, "Json"]]
+PROFILES: Final = ("staticduo", "defend1")
+MANUAL_DEADLINE: Final = 600
+ROUTE_FIELDS: Final = (*discovery.ROUTE_FIELDS,)
+
+
+def document(value: object) -> dict[str, Json]:
+    decoded: Final = json.loads(c.canonical(value))
+    c.check(isinstance(decoded, dict), "claude_invalid_document")
+    return cast(dict[str, Json], decoded)
+
+
+def mapping(value: Json) -> dict[str, Json]:
+    c.check(isinstance(value, dict), "claude_invalid_document")
+    return cast(dict[str, Json], value)
+
+
+def sequence(value: Json) -> list[Json]:
+    c.check(isinstance(value, list), "claude_invalid_document")
+    return cast(list[Json], value)
+
+
+def text(value: Json) -> str:
+    c.check(isinstance(value, str) and 0 < len(value) <= 512, "claude_invalid_identity")
+    return cast(str, value)
+
+
+class API(Protocol):
+    def request(self, host: str, path: str, method: str = "GET", body: object = None) -> object: ...
+
+
+class Journal(Protocol):
+    def load(self) -> object: ...
+    def save(self, state: object) -> None: ...
+
+
+@dataclass(frozen=True, slots=True)
+class Deployment:
+    identifier: str
+    alias: str
+    upstream: str
+    profile: str
+
+    def payload(self) -> dict[str, Json]:
+        return {"id": self.identifier, "alias": self.alias, "upstream": self.upstream, "profile": self.profile}
+
+
+@dataclass(frozen=True, slots=True)
+class View:
+    rows: tuple[Deployment, ...]
+    routes: bytes
+
+    def payload(self) -> dict[str, Json]:
+        return {"rows": [row.payload() for row in self.rows], "routes": document(c.decode(self.routes))}
+
+
+@dataclass(frozen=True, slots=True)
+class Operation:
+    host: str
+    identifier: str
+    before: str
+    after: str
+
+    def payload(self) -> dict[str, Json]:
+        return {"host": self.host, "id": self.identifier, "before": self.before, "after": self.after}
+
+
+def parse_view(raw: Json) -> View:
+    value: Final = mapping(raw)
+    rows: Final = tuple(mapping(row) for row in sequence(value["rows"]))
+    return View(
+        tuple(
+            Deployment(text(row["id"]), text(row["alias"]), text(row["upstream"]), text(row["profile"])) for row in rows
+        ),
+        c.canonical(value["routes"]),
+    )
+
+
+def parse_operation(raw: Json) -> Operation:
+    value: Final = mapping(raw)
+    return Operation(text(value["host"]), text(value["id"]), text(value["before"]), text(value["after"]))
+
+
+def advance(view: View, op: Operation, inverse: bool = False) -> View:
+    target: Final = op.before if inverse else op.after
+    return replace(
+        view, rows=tuple(replace(row, profile=target) if row.identifier == op.identifier else row for row in view.rows)
+    )
+
+
+class Selector:
+    def __init__(
+        self,
+        api: API,
+        journal: Journal,
+        bindings: Callable[[Sequence[str]], object],
+        hosts: Sequence[str],
+        clock: Callable[[], float] = time.time,
+    ) -> None:
+        self.api = api
+        self.journal = journal
+        self.bindings = bindings
+        self.hosts = tuple(hosts)
+        self.clock = clock
+
+    def snapshot(self, state: Mapping[str, Json]) -> dict[str, View]:
+        attestations: Final = mapping(state.get("anthropic_attestations"))
+        discovered: Final = document(self.bindings(self.hosts))
+        return {
+            host: self.host_view(host, mapping(attestations[host]), mapping(discovered[host])) for host in self.hosts
+        }
+
+    def host_view(self, host: str, att: Mapping[str, Json], bindings: Mapping[str, Json]) -> View:
+        c.check(att.get("exclusive_ownership") is True, "claude_exclusive_ownership_required")
+        c.check(
+            att.get("identity_verified") is True and att.get("credential_sources_read_only") is True,
+            "claude_credentials_attestation_required",
+        )
+        c.check(
+            mapping(att.get("identity_profiles")) == {profile: profile for profile in PROFILES},
+            "claude_identity_profiles_invalid",
+        )
+        models: Final = document(self.api.request(host, "/model/info"))
+        settings: Final = document(self.api.request(host, "/router/settings"))
+        fields: Final = settings.get("fields")
+        flat_fields: Final = tuple(mapping(field) for field in sequence(fields)) if fields is not None else ()
+        c.check(len({text(field["field_name"]) for field in flat_fields}) == len(flat_fields), "duplicate_router_field")
+        flat: Final = (
+            {text(field["field_name"]): field.get("field_value") for field in flat_fields}
+            if fields is not None
+            else settings
+        )
+        routes: Final = {field: flat.get(field) for field in ROUTE_FIELDS}
+        model_rows: Final = tuple(mapping(row) for row in sequence(models["data"]))
+        expected: Final = tuple(mapping(row) for row in sequence(att["deployments"]))
+        owned_names: Final = frozenset(text(row["alias"]) for row in expected)
+        owned_ids: Final = frozenset(text(row["id"]) for row in expected)
+        selected: Final = tuple(
+            row
+            for row in model_rows
+            if row.get("model_name") in owned_names or mapping(row["model_info"]).get("id") in owned_ids
+        )
+        c.check(0 < len(selected) <= 100, "claude_inventory_empty_or_oversized")
+        deployments: Final = tuple(self.deployment(row, bindings) for row in selected)
+        c.check(len({row.identifier for row in deployments}) == len(deployments), "claude_duplicate_id")
+        c.check(len({row.alias for row in deployments}) == len(deployments), "claude_duplicate_alias")
+        live_identity: Final = {
+            c.canonical({"id": row.identifier, "alias": row.alias, "upstream": row.upstream}) for row in deployments
+        }
+        c.check(live_identity == {c.canonical(row) for row in expected}, "claude_inventory_ownership_conflict")
+        by_alias: Final = {row.alias: row for row in deployments}
+        neutral: Final = tuple(row for row in deployments if row.alias.startswith("claude-") and "/" not in row.alias)
+        c.check(bool(neutral), "claude_no_neutral_aliases")
+        aliases: Final = c.alias_map(flat)
+        for row in neutral:
+            c.check(
+                row.alias not in aliases and row.upstream == "anthropic/" + row.alias, "claude_neutral_alias_conflict"
+            )
+            for profile in PROFILES:
+                named: Final = by_alias.get("claude-" + profile + "/" + row.alias)
+                c.check(
+                    named is not None and named.profile == profile and named.upstream == row.upstream,
+                    "claude_explicit_account_conflict",
+                )
+        return View(tuple(sorted(deployments, key=lambda row: row.identifier)), c.canonical(routes))
+
+    @staticmethod
+    def deployment(row: Mapping[str, Json], bindings: Mapping[str, Json]) -> Deployment:
+        params: Final = mapping(row["litellm_params"])
+        identifier: Final = text(mapping(row["model_info"])["id"])
+        alias: Final = text(row["model_name"])
+        upstream: Final = text(params["model"])
+        binding: Final = mapping(bindings.get(identifier))
+        c.check(
+            all(
+                binding.get(key) == value
+                for key, value in (
+                    ("alias", alias),
+                    ("upstream", upstream),
+                    ("observed", params.get("anthropic_auth_profile")),
+                )
+            ),
+            "claude_profile_discovery_conflict",
+        )
+        c.check(
+            params.get("use_anthropic_oauth") is True
+            and binding.get("credential_mode") == "claude_code"
+            and params.get("anthropic_credential_mode") == binding.get("credential_observed"),
+            "claude_credential_mode_required",
+        )
+        c.check(params.get("anthropic_execution_mode") == "native_client", "claude_native_execution_required")
+        c.check(
+            not any(params.get(field) is not None for field in discovery.OVERRIDES), "claude_profile_override_conflict"
+        )
+        profile: Final = text(binding["profile"])
+        c.check(profile in PROFILES, "claude_unknown_profile")
+        return Deployment(identifier, alias, upstream, profile)
+
+    def write(self, op: Operation, inverse: bool = False) -> None:
+        self.api.request(
+            op.host,
+            "/model/" + quote(op.identifier, safe="") + "/update",
+            "PATCH",
+            {"litellm_params": {"anthropic_auth_profile": op.before if inverse else op.after}},
+        )
+
+    def recover(self, state: Mapping[str, Json]) -> dict[str, Json]:
+        transaction: Final = mapping(state["claude_transaction"])
+        attempted: Final = tuple(parse_operation(raw) for raw in sequence(transaction["attempted"]))
+        uncertain_at: Final = transaction.get("uncertain_at")
+        if uncertain_at is not None:
+            c.check(
+                type(uncertain_at) in (int, float) and self.clock() - cast(float, uncertain_at) >= c.RECOVERY_GRACE,
+                "claude_recovery_waiting_revalidation",
+            )
+        before: Final = {host: parse_view(raw) for host, raw in mapping(transaction["before"]).items()}
+        live: Final = self.snapshot(state)
+        recovered: Final = self.recovery_expected(before, live, attempted)
+        for op in reversed(attempted):
+            current: Final = next(row.profile for row in recovered[op.host].rows if row.identifier == op.identifier)
+            if current == op.before:
+                continue
+            latest: Final = self.snapshot(state)
+            self.recovery_expected(before, latest, attempted)
+            pending: Final = {**transaction, "uncertain_at": self.clock()}
+            self.journal.save({**state, "status": "blocked", "claude_transaction": pending})
+            try:
+                self.write(op, inverse=True)
+            except Exception:
+                raise c.Stop("claude_recovery_write_uncertain") from None
+            actual: Final = self.snapshot(state)
+            desired: Final = {**latest, op.host: advance(latest[op.host], op, inverse=True)}
+            c.check(actual == desired, "claude_rollback_unverified")
+        restored: Final = self.snapshot(state)
+        c.check(restored == before, "claude_rollback_conflict")
+        ready: Final = {**state, "status": "ready", "claude_transaction": None}
+        self.journal.save(ready)
+        return ready
+
+    @staticmethod
+    def recovery_expected(
+        before: Mapping[str, View], live: Mapping[str, View], attempted: Sequence[Operation]
+    ) -> dict[str, View]:
+        c.check(len({(op.host, op.identifier) for op in attempted}) == len(attempted), "claude_recovery_invalid")
+        selected: Final = {(op.host, op.identifier): op for op in attempted}
+        expected: Final = {
+            host: replace(view, rows=tuple(Selector.recovery_row(host, row, live, selected) for row in view.rows))
+            for host, view in before.items()
+        }
+        c.check(dict(live) == expected, "claude_recovery_conflict")
+        return expected
+
+    @staticmethod
+    def recovery_row(
+        host: str, row: Deployment, live: Mapping[str, View], selected: Mapping[tuple[str, str], Operation]
+    ) -> Deployment:
+        op: Final = selected.get((host, row.identifier))
+        if op is None:
+            return row
+        actual: Final = next((item for item in live[host].rows if item.identifier == row.identifier), None)
+        c.check(
+            actual is not None and actual.profile in (op.before, op.after) and row.profile == op.before,
+            "claude_recovery_conflict",
+        )
+        return replace(row, profile=cast(Deployment, actual).profile)
+
+    def run(self, profile: str | None) -> dict[str, Json]:
+        state: Final = document(self.journal.load())
+        c.check(not state.get("transaction"), "recovery_required")
+        c.check(state.get("status") == "ready" or state.get("claude_transaction"), "recovery_blocked")
+        if profile is None:
+            current: Final = self.snapshot(state)
+            return {
+                "decision": "status",
+                "controller_status": state["status"],
+                "pending_transaction": bool(state.get("claude_transaction")),
+                "hosts": {
+                    host: {row.alias: row.profile for row in view.rows if "/" not in row.alias}
+                    for host, view in current.items()
+                },
+            }
+        c.check(profile in PROFILES, "claude_unknown_profile")
+        active: Final = self.recover(state) if state.get("claude_transaction") else state
+        before: Final = self.snapshot(active)
+        operations: Final = tuple(self.host_operations(host, view, profile) for host, view in before.items())
+        ops: Final = tuple(chain.from_iterable(operations))
+        c.check(len(ops) <= c.MAX_OPERATIONS, "operation_budget_exceeded")
+        if not ops:
+            return {"decision": "noop", "profile": profile}
+        transaction: Final[dict[str, Json]] = {
+            "before": {host: view.payload() for host, view in before.items()},
+            "attempted": [],
+        }
+        self.journal.save({**active, "status": "blocked", "claude_transaction": transaction})
+        try:
+            self.apply(active, before, ops, transaction)
+        except Exception:
+            failed: Final = document(self.journal.load())
+            pending: Final = mapping(failed.get("claude_transaction"))
+            if not sequence(pending["attempted"]):
+                self.journal.save({**active, "status": "ready", "claude_transaction": None})
+            raise c.Stop("claude_operation_pending_recovery") from None
+        self.journal.save({**active, "status": "ready", "claude_transaction": None})
+        return {"decision": "apply", "profile": profile}
+
+    @staticmethod
+    def host_operations(host: str, view: View, profile: str) -> tuple[Operation, ...]:
+        return tuple(
+            Operation(host, row.identifier, row.profile, profile)
+            for row in view.rows
+            if "/" not in row.alias and row.profile != profile
+        )
+
+    def apply(
+        self,
+        state: Mapping[str, Json],
+        before: Mapping[str, View],
+        ops: Sequence[Operation],
+        transaction: Mapping[str, Json],
+    ) -> None:
+        for index, op in enumerate(ops):
+            expected: Final = self.expected_after(before, ops[:index])
+            c.check(self.snapshot(state) == expected, "claude_live_precondition_conflict")
+            pending: Final = {
+                **transaction,
+                "attempted": [item.payload() for item in ops[: index + 1]],
+                "uncertain_at": self.clock(),
+            }
+            self.journal.save({**state, "status": "blocked", "claude_transaction": pending})
+            self.write(op)
+            c.check(self.snapshot(state) == self.expected_after(before, ops[: index + 1]), "claude_write_unverified")
+            verified: Final = {key: value for key, value in pending.items() if key != "uncertain_at"}
+            self.journal.save({**state, "status": "blocked", "claude_transaction": verified})
+        c.check(self.snapshot(state) == self.expected_after(before, ops), "claude_final_verification_failed")
+
+    @staticmethod
+    def expected_after(before: Mapping[str, View], ops: Sequence[Operation]) -> dict[str, View]:
+        selected: Final = {(op.host, op.identifier): op.after for op in ops}
+        return {
+            host: replace(
+                view,
+                rows=tuple(
+                    replace(row, profile=selected.get((host, row.identifier), row.profile)) for row in view.rows
+                ),
+            )
+            for host, view in before.items()
+        }
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    from memory_model_admin import host_config
+
+    parser: Final = argparse.ArgumentParser(description="Selecciona la cuenta ClaudeCode en los aliases Claude.")
+    parser.add_argument("profile", nargs="?", choices=PROFILES)
+    parser.add_argument("--status", action="store_true")
+    args: Final = parser.parse_args(argv)
+    if args.status and args.profile:
+        parser.error("--status no admite una cuenta")
+    config: Final = host_config()
+    journal: Final = c.Journal(config["state_directory"], config["journal_key_file"])
+    selector: Final = Selector(c.API(config), journal, discovery.collect_bindings, tuple(config["targets"]))
+    try:
+        with journal.lock(), c.deadline(MANUAL_DEADLINE):
+            result: Final = selector.run(None if args.status else args.profile)
+        print(json.dumps(result, sort_keys=True))
+        return 0
+    except (Exception, c.CycleExpired) as error:
+        code: Final = str(error) if isinstance(error, c.Stop) else "claude_operation_failed"
+        print(json.dumps({"decision": "freeze", "reason_codes": [code]}))
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
