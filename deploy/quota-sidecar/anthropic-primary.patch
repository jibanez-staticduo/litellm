+        if profile not in ("staticduo", "defend1"):
+            raise ValueError("unknown_profile")
+        observed = params.get("anthropic_auth_profile")
+        if observed != mask(profile):
+            raise ValueError("mask_conflict")
+        mode_observed = params.get("anthropic_credential_mode")
+        if mode_observed != mask("claude_code", "anthropic_credential_mode"):
+            raise ValueError("credential_mode_mask_conflict")
+        bindings[identifier] = {"profile": profile, "alias": alias, "upstream": upstream, "observed": observed,
+            "credential_mode": "claude_code", "credential_observed": mode_observed}
+    return bindings
+
+
+def get(path):
