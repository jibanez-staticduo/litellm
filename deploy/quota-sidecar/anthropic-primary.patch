+
+def collect_host(host: str) -> object:
+    c.check(host in c.HOST_URLS, "target_host_mismatch")
+    local: Final = ("docker", "exec", "-i", "litellm", "python3", "-")
+    command: Final = (*SSH_BASE, "nas", *local) if host == "nas" else local
+    try:
+        result: Final = subprocess.run(
+            command, input=INSIDE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=45
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        raise c.Stop("claude_profile_discovery_failed") from None
+    c.check(result.returncode == 0 and len(result.stdout) <= MAX_HOST_OUTPUT, "claude_profile_discovery_failed")
+    kind, bindings, _ = parse_host_output(result.stdout)
+    c.check(kind == "discover", "claude_profile_discovery_failed")
+    return bindings
+
+
+def collect_bindings(hosts: Sequence[str], collector: Callable[[str], object] = collect_host) -> object:
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        results: Final = tuple(executor.map(collector, hosts))
+    return dict(zip(hosts, results, strict=True))
+
+
+if __name__ == "__main__":
+    try:
+        print(json.dumps({"observed_at": time.time(), "hosts": collect_bindings(tuple(c.HOST_URLS))}, sort_keys=True))
+    except c.Stop:
+        print('{"error":"claude_profile_discovery_failed"}')
+        raise SystemExit(1) from None
