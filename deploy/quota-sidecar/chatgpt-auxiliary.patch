+import copy
+import unittest
+from test_policy import fixture, apply_fixture, NOW
+from policy import AUXILIARY, plan
+import controller
+
+
+def auxiliary_fixture(a, b):
+    data = fixture(a, b)
+    inventory, routes = data[1:3]
+    for host in inventory:
+        originals = [d for d in inventory[host]['deployments'] if d['upstream'] == 'chatgpt/gpt-5.4']
+        chain = next(e['gpt-5.4'] for e in routes[host]['fallbacks'] if 'gpt-5.4' in e)
+        for name in AUXILIARY:
+            for deployment in originals:
+                row = copy.deepcopy(deployment)
+                for key in ('alias', 'id', 'upstream'):
+                    row[key] = row[key].replace('gpt-5.4', name)
+                inventory[host]['deployments'].append(row)
+            routes[host]['fallbacks'].append({name: [x.replace('gpt-5.4', name) for x in chain]})
+    return data
+
+
+class AuxiliaryTests(unittest.TestCase):
+    def test_rotation_exhaustion_and_recovery(self):
+        for usage in ((20, 10), (50, 60), (100, 100)):
+            data = auxiliary_fixture(*usage)
+            result = plan(*data, now=NOW)
+            self.assertEqual(result['decision'], 'apply')
+            for host, target in result['targets'].items():
+                aliases = {a['alias']: a for a in target['aliases']}
+                for name in AUXILIARY:
+                    self.assertIn(name, aliases)
+                    self.assertEqual(aliases[name]['identity_order'], aliases['gpt-5.4']['identity_order'])
+                    self.assertNotIn('gpt-reserve', aliases[name]['fallback_after'])
+                    self.assertNotIn(name, target['ownership_after'])
+                    self.assertTrue(all(x.endswith('/' + name) for x in aliases[name]['fallback_after']))
+            applied = apply_fixture(data, result)
+            self.assertEqual(plan(*applied, now=NOW)['decision'], 'noop')
+            applied[0]['accounts'][0]['weekly']['used_percent'] = 1
+            applied[0]['accounts'][1]['weekly']['used_percent'] = 2
+            recovered = plan(*applied, now=NOW)
+            self.assertNotEqual(recovered['decision'], 'freeze')
+            self.assertTrue(all(not t['ownership_after'] for t in recovered['targets'].values()))
+
+    def test_guardian_requires_verified_profile(self):
+        inventory, routes = auxiliary_fixture(10, 20)[1:3]
+        inv = inventory['nas']
+        rows = [{'model_name': d['alias'], 'model_info': {'id': d['id']},
+                 'litellm_params': {'model': d['upstream'], **({'chatgpt_auth_profile': d['profile']}
+                    if 'profile' in d else {})}} for d in inv['deployments']]
+        att = {'default_auth_equivalent': True, 'identity_profiles': inv['identity_profiles'],
+               'deployments': [{k: d[k] for k in ('id', 'alias', 'upstream')} for d in inv['deployments']]}
+        verified, _ = controller.adapt('nas', {'data': rows}, routes['nas'], att)
+        guardian = next(d for d in verified['deployments'] if d['alias'] == 'codex-auto-review')
+        self.assertTrue(guardian['identity_verified'])
+        next(r for r in rows if r['model_name'] == 'codex-auto-review')['litellm_params']['chatgpt_auth_profile'] = 'unknown'
+        with self.assertRaisesRegex(controller.Stop, 'unknown_live_profile'):
+            controller.adapt('nas', {'data': rows}, routes['nas'], att)
